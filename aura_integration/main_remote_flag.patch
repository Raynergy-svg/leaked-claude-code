     companion = AuraCompanion(db_path=db_path, bridge_dir=bridge_dir)
 
+    # Remote transport (optional — sidecar for IDE/web connections)
+    remote_transport = None
+    if args.remote:
+        try:
+            from src.aura.transport.remote import RemoteTransport
+            from src.aura.protocol.messages import MessageType, create_message
+
+            def on_remote_message(msg):
+                """Handle messages from remote clients."""
+                if msg.type == MessageType.USER_MESSAGE:
+                    text = msg.data.get("text", "")
+                    if text:
+                        response = companion.process_input(text)
+                        # Send response back via transport
+                        resp_msg = create_message(
+                            MessageType.AURA_RESPONSE,
+                            {"text": response},
+                        )
+                        if remote_transport:
+                            remote_transport.write(resp_msg)
+
+            remote_transport = RemoteTransport(
+                socket_path="/tmp/aura-sidecar.sock",
+                on_message=on_remote_message,
+            )
+            remote_transport._sidecar.ws_port = args.ws_port
+            if args.auth_token:
+                remote_transport._sidecar.auth_token = args.auth_token
+
+            if remote_transport.start():
+                brand.print_info(
+                    f"Remote transport active — WebSocket on port {args.ws_port}"
+                )
+                if args.auth_token:
