+    def _cmd_history(self, cmd: str) -> str:
+        """Show recent session history."""
+        brand = get_brand()
+        p = brand.c("primary")
+        s = brand.c("secondary")
+        d = brand.c("text_dim")
+        rst = BRAND_RESET
+
+        parts = cmd.strip().split()
+        limit = 10
+        if len(parts) > 1:
+            try:
+                limit = int(parts[1])
+            except ValueError:
+                pass
+
+        sessions = self._session_index.list_sessions(limit=limit)
+        if not sessions:
+            return f"{d}No session history yet. Start chatting to build history.{rst}"
+
+        lines = [brand.render_header("Session History", style="heavy"), ""]
+        for sess in sessions:
+            # Format readiness as bar
+            r_start = f"{sess.readiness_start:.0f}" if sess.readiness_start is not None else "?"
+            r_end = f"{sess.readiness_end:.0f}" if sess.readiness_end is not None else "?"
+            arc_icon = {"improving": "+", "declining": "-", "stable": "=", "volatile": "~"}.get(
+                sess.emotional_arc, "?"
+            )
+            status = f"{d}ended{rst}" if sess.end_time else f"{s}active{rst}"
+            lines.append(
+                f"  {p}{sess.session_id}{rst}  "
+                f"{d}{sess.message_count} msgs{rst}  "
+                f"readiness {r_start}→{r_end} [{arc_icon}]  "
+                f"{status}"
+            )
+        lines.append("")
+        lines.append(f"  {d}Use /replay <session_id> to review a session.{rst}")
+        return "\n".join(lines)
+
+    def _cmd_replay(self, cmd: str) -> str:
+        """Replay a session's readiness trajectory."""
+        brand = get_brand()
+        p = brand.c("primary")
+        s = brand.c("secondary")
+        d = brand.c("text_dim")
+        w = brand.c("warning")
+        rst = BRAND_RESET
+
+        parts = cmd.strip().split()
+        if len(parts) < 2:
+            # Default to current session
+            session_id = self._conversation_id
+        else:
+            session_id = parts[1]
+
+        # Try to find the session (partial match)
+        sessions = self._history_reader.list_sessions()
+        matched = [s for s in sessions if session_id in s]
+        if not matched:
+            return f"{w}Session not found: {session_id}{rst}\n  Use /history to see available sessions."
+        session_id = matched[0]  # Use first match
+
+        page = self._history_reader.fetch_latest(session_id, limit=200)
+        if not page or not page.events:
+            return f"{d}No events in session {session_id}.{rst}"
+
+        lines = [brand.render_header(f"Replay: {session_id}", style="heavy"), ""]
+
+        readiness_points = []
+        for event in page.events:
+            if event.type == "user_message":
+                text = event.data.get("text", "")[:80]
+                lines.append(f"  {s}You:{rst} {text}")
+            elif event.type == "aura_response":
+                text = event.data.get("text", "")[:80]
+                lines.append(f"  {p}Aura:{rst} {text}")
+            elif event.type == "readiness_update":
+                score = event.data.get("score", 0)
+                readiness_points.append(score)
+                bar_len = int(score / 5)
+                bar = "█" * bar_len + "░" * (20 - bar_len)
+                lines.append(f"  {d}  readiness: {bar} {score:.0f}{rst}")
+
+        if readiness_points:
+            lines.append("")
+            lines.append(f"  {s}Readiness trajectory:{rst}")
+            # Simple sparkline
+            mn, mx = min(readiness_points), max(readiness_points)
+            spark_chars = "▁▂▃▄▅▆▇█"
+            sparkline = ""
+            for pt in readiness_points:
+                if mx == mn:
+                    idx = 4
+                else:
+                    idx = int((pt - mn) / (mx - mn) * 7)
+                sparkline += spark_chars[idx]
+            lines.append(f"  {p}{sparkline}{rst}  ({mn:.0f} → {mx:.0f})")
+
+        lines.append("")
+        lines.append(f"  {d}{len(page.events)} events, has_more={page.has_more}{rst}")
+        return "\n".join(lines)
