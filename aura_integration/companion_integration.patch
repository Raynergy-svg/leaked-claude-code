+    def _get_sprite_user_id(self) -> str:
+        """Get a stable user ID for sprite generation."""
+        # Use the trader's person node if onboarded, otherwise a default
+        try:
+            stats = self.graph.get_stats()
+            nodes = stats.get("nodes_by_type", {})
+            if nodes.get("person", 0) > 0:
+                return "person_trader"
+        except Exception:
+            pass
+        return "aura-default-user"
+
+    def _cmd_sprite(self) -> str:
+        """Show the companion sprite with stats."""
+        brand = get_brand()
+        user_id = self._get_sprite_user_id()
+        r = sprite_roll(user_id)
+        b = r.bones
+
+        theme = brand._theme if hasattr(brand, '_theme') else None
+        if theme:
+            lines = render_sprite_colored(b, frame=0, theme=theme)
+        else:
+            lines = render_sprite(b, frame=0)
+
+        stars = RARITY_STARS.get(b.rarity, "")
+        p = brand.c("primary")
+        s = brand.c("secondary")
+        d = brand.c("text_dim")
+        rst = BRAND_RESET
+
+        output = [brand.render_header("Companion Sprite", style="heavy")]
+        output.append("")
+        for line in lines:
+            output.append(f"    {line}")
+        output.append("")
+        output.append(f"    {p}{b.species}{rst}  {render_face(b)}  {stars}  {d}{b.rarity}{rst}")
+        if b.shiny:
+            output.append(f"    {brand.c('warning')}✨ SHINY ✨{rst}")
+        output.append("")
+        output.append(f"    {s}Stats:{rst}")
+        for stat_name, val in b.stats.items():
+            bar = "█" * (val // 5) + "░" * (20 - val // 5)
+            output.append(f"    {d}{stat_name:<12}{rst} {bar} {val}")
+        output.append("")
+        return "\n".join(output)
